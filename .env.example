# PostgreSQL (Prisma Migrate / Prisma Client). Copy to `.env` or `.env.local` and adjust.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workflowhub?schema=public"

# Server-only secret for signed HTTP-only session cookies (TASK-012). Use a long random string (32+ chars).
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Optional; default 30. Cookie Max-Age in days (PRD §5.7 — session until expiry).
# SESSION_MAX_AGE_DAYS=30

# Tunable limits (PRD §8). Defaults match PRD; omit or leave empty to use defaults.
# MEDIA_IMAGE_MAX_MB=3
# MEDIA_VIDEO_MAX_MB=12
# ANON_COOKIE_TTL_DAYS=365
# ANON_NEW_DEVICE_PER_IP_PER_WORKFLOW_HOUR=10
# DOWNLOAD_RATE_LIMIT_PER_IP_PER_MIN=30
# REVIEW_BODY_MAX_CHARS=2000

# S3-compatible object storage (workflow JSON + media). Optional until uploads use storage.
# If S3_BUCKET is set, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are required.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=workflowhub-artifacts
