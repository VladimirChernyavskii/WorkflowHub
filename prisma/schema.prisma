generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Baseline table for migration tooling (TASK-002). Domain models are added in later tasks.
model SchemaBaseline {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schema_baseline")
}
