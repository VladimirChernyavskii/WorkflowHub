generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  google
  github
}

enum UserRole {
  user
  admin
}

enum WorkflowStatus {
  draft
  published
  archived
}

enum WorkflowNodeSource {
  derived
  admin
}

enum MediaAssetKind {
  image
  video
}

enum MediaAssetRole {
  input_example
  output_example
}

/// PRD §6.1
model User {
  id              String       @id @default(uuid()) @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  displayName     String       @map("display_name")
  role            UserRole
  createdAt       DateTime     @default(now()) @map("created_at")

  downloadEvents    DownloadEvent[]
  uniqueDownloads   UniqueDownload[]
  reviews           Review[]
  adminAuditLogs    AdminAuditLog[]

  @@unique([provider, providerSubject])
  @@map("users")
}

/// PRD §6.2. v1: one row in `workflow_files` per workflow = current JSON artifact only; history lives in object storage if needed.
model Workflow {
  id                  String         @id @default(uuid()) @db.Uuid
  slug                String         @unique
  title               String
  description         String         @db.Text
  status              WorkflowStatus
  baseModel           String         @map("base_model")
  comfyVersion        String         @map("comfy_version")
  authorDisplayName   String         @map("author_display_name")
  uniqueDownloadCount Int            @default(0) @map("unique_download_count")
  averageRating       Decimal        @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount         Int            @default(0) @map("review_count")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  publishedAt         DateTime?      @map("published_at")

  currentFile     WorkflowFile?
  nodes           WorkflowNode[]
  workflowTags    WorkflowTag[]
  downloadEvents  DownloadEvent[]
  uniqueDownloads UniqueDownload[]
  reviews         Review[]
  mediaAssets     MediaAsset[]

  @@map("workflows")
}

/// PRD §6.3. Unique `workflow_id` enforces a single current file per workflow (see Workflow).
model WorkflowFile {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @unique @map("workflow_id") @db.Uuid
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  storageKey  String   @map("storage_key")
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  sha256      String?  @map("sha256")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  @@map("workflow_files")
}

/// PRD §6.4. v1: final ordered display list after each parse/admin save.
model WorkflowNode {
  id         String              @id @default(uuid()) @db.Uuid
  workflowId String              @map("workflow_id") @db.Uuid
  workflow   Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeType   String              @map("node_type")
  sortOrder  Int                 @map("sort_order")
  source     WorkflowNodeSource

  @@map("workflow_nodes")
}

/// PRD §6.5
model Tag {
  id           String         @id @default(uuid()) @db.Uuid
  slug         String         @unique
  name         String
  workflowTags WorkflowTag[]

  @@map("tags")
}

/// PRD §6.5. Composite PK = unique (workflow_id, tag_id). CASCADE cleans links when workflow or tag is removed.
model WorkflowTag {
  workflowId String   @map("workflow_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([workflowId, tagId])
  @@map("workflow_tags")
}

/// PRD §6.6. Raw download requests for admin diagnostics.
model DownloadEvent {
  id            String   @id @default(uuid()) @db.Uuid
  workflowId    String   @map("workflow_id") @db.Uuid
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId        String?  @map("user_id") @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonDeviceId  String?  @map("anon_device_id")
  ipHash        String   @map("ip_hash")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  countedUnique Boolean  @map("counted_unique")

  @@map("download_events")
}

/// PRD §6.7. At most one row per (workflow, user) or per (workflow, anon_device) for non-null keys — enforced by partial unique indexes in migration SQL.
model UniqueDownload {
  id           String   @id @default(uuid()) @db.Uuid
  workflowId   String   @map("workflow_id") @db.Uuid
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonDeviceId String?  @map("anon_device_id")
  firstAt      DateTime @default(now()) @map("first_at")

  @@map("unique_downloads")
}

/// PRD §6.8. Uniqueness (workflow_id, user_id) for active rows only — partial unique index in migration SQL.
model Review {
  id         String    @id @default(uuid()) @db.Uuid
  workflowId String    @map("workflow_id") @db.Uuid
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  body       String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("reviews")
}

/// PRD §6.9. Max counts per (workflow_id, role, kind) are enforced in application code. ON DELETE CASCADE removes rows when the workflow is deleted.
model MediaAsset {
  id          String         @id @default(uuid()) @db.Uuid
  workflowId  String         @map("workflow_id") @db.Uuid
  workflow    Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  kind        MediaAssetKind
  role        MediaAssetRole
  storageKey  String         @map("storage_key")
  byteSize    Int            @map("byte_size")
  mimeType    String         @map("mime_type")
  sortOrder   Int            @map("sort_order")

  @@map("media_assets")
}

/// PRD §6.10. Application writers must not put secrets, tokens, or raw credentials in `payloadJson` — redact before persist; store only safe ids and metadata.
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  adminUser    User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  payloadJson  Json     @map("payload_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
}

/// Baseline table for migration tooling (TASK-002). Domain models are added in later tasks.
model SchemaBaseline {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("schema_baseline")
}
